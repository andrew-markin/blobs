{
  "name": "mayfleet-blobs",
  "version": "1.0.0",
  "author": "Andrew Markin",
  "license": "GPL-3.0-only",
  "type": "module",
  "config": {
    "authority": "developer@blobs.mayfleet.com"
  },
  "scripts": {
    "start": "node src/server.js",
    "token": "node src/token.js",
    "test": "node --test 'test/**/*.test.js'",
    "check": "run-s check:*",
    "check:eslint": "eslint .",
    "check:format": "prettier --check .",
    "audit": "npm audit --omit=dev",
    "deploy": "cross-env RELEASE=$(date -u +%Y%m%d-%H%M%S)-$(git rev-parse --short HEAD) npm-run-all deploy:*",
    "deploy:check": "test -z \"$(git status --porcelain)\" || (echo 'Working tree is not clean, commit or stash changes first' && exit 1)",
    "deploy:build": "rm -rf dist && ncc build src/server.js -o dist --minify",
    "deploy:upload": "rsync -az --rsync-path=\"mkdir -p ~/blobs/releases && rsync\" dist/ $npm_package_config_authority:blobs/releases/$RELEASE/",
    "deploy:activate": "ssh $npm_package_config_authority bash -s -- activate $RELEASE < deploy/remote.sh",
    "deploy:prune": "ssh $npm_package_config_authority bash -s -- prune < deploy/remote.sh",
    "deploy:cleanup": "rm -rf dist",
    "rollback": "ssh $npm_package_config_authority bash -s -- rollback < deploy/remote.sh"
  },
  "dependencies": {
    "async-lock": "^1.4.1",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mortice": "^3.3.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@vercel/ncc": "^0.38.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "socket.io-client": "^4.8.4"
  }
}
