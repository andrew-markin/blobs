{
  "apps": [
    {
      "name": "blobs",
      "script": "current/index.js",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "max_memory_restart": "512M",
      "cron_restart": "0 0 * * *",
      "time": true,
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000,
        "TOKEN_SECRET": "REPLACE_WITH_A_LONG_RANDOM_SECRET",
        "STORAGE": "/home/developer/.local/share/blobs/storage"
      }
    }
  ]
}
